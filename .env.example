# Telegram Bot API token from @BotFather (single corporate bot for v0.1)
BOT_TOKEN=123456789:AAH_your_bot_token_here

# Comma-separated numeric Telegram user IDs of administrators (/status, /revoke_user)
ADMIN_TG_IDS=11223344,55667788

# HTTP listen address for Streamable HTTP MCP (/mcp) and healthcheck (/healthz)
LISTEN_ADDR=:8080

# SQLite storage path or URI (for profile lite)
DATABASE_URL=sqlite:///data/mcpgram.db

# History visibility policy for chat members:
#   full_history - access full stored chat history including messages before join (default)
#   since_join   - restrict access to messages strictly newer than user's joined_at
DEFAULT_HISTORY_POLICY=full_history

# Privacy & retention settings
# RETENTION_DAYS=0 keeps messages indefinitely (default); set > 0 (e.g. 90) to auto-delete older messages
RETENTION_DAYS=0
# TOKEN_TTL_DAYS=90 expires Bearer tokens after 90 days; set 0 for non-expiring tokens until revoked
TOKEN_TTL_DAYS=90
IGNORE_TAG=#offrecord

# RBAC cache TTL before forcing a live getChatMember check (Go duration: 5m, 10m, etc.)
RBAC_CACHE_TTL=5m

# Optional HTTP/SOCKS5 proxy for api.telegram.org (e.g. socks5://user:pass@host:1080)
TELEGRAM_PROXY_URL=

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Nightly chat digests (v0.2): off | openai_compatible
# Works with local Ollama (http://127.0.0.1:11434/v1), llama.cpp/vLLM, or OpenAI/OpenRouter.
DIGEST_MODE=off
# DIGEST_BASE_URL=http://127.0.0.1:11434/v1
# DIGEST_API_KEY=
# DIGEST_MODEL=qwen2.5:7b
# DIGEST_SCHEDULE_HOUR=3
# DIGEST_TIMEZONE=UTC
# DIGEST_MIN_MESSAGES=3
# DIGEST_LOOKBACK_DAYS=7
